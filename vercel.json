{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "functions": {
    "api/user.js":      { "maxDuration": 30 },
    "api/send.js":      { "maxDuration": 30 },
    "api/caption.js":   { "maxDuration": 30 },
    "api/broadcast.js": { "maxDuration": 30 },
    "api/webhook.js":   { "maxDuration": 60 }
  },
  "routes": [
    { "src": "/api/user",      "dest": "/api/user.js" },
    { "src": "/api/send",      "dest": "/api/send.js" },
    { "src": "/api/caption",   "dest": "/api/caption.js" },
    { "src": "/api/broadcast", "dest": "/api/broadcast.js" },
    { "src": "/api/webhook",   "dest": "/api/webhook.js" },
    { "src": "/sw.js",         "dest": "/public/sw.js",
      "headers": { "Service-Worker-Allowed": "/" } },
    { "src": "/(.*)",          "dest": "/public/$1" }
  ],
  "env": {
    "BOT_TOKEN":          "@bot_token",
    "ADMIN_ID":           "@admin_id",
    "JSONBIN_BIN_ID":     "@jsonbin_bin_id",
    "JSONBIN_MASTER_KEY": "@jsonbin_master_key",
    "JSONBIN_ACCESS_KEY": "@jsonbin_access_key",
    "VAPID_PUBLIC_KEY":   "@vapid_public_key",
    "VAPID_PRIVATE_KEY":  "@vapid_private_key",
    "SITE_URL":           "@site_url",
    "WEBHOOK_URL":        "@webhook_url"
  }
}
