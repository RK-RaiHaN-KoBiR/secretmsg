{
  "version": 2,
  "functions": {
    "api/webhook.js": { "memory": 256, "maxDuration": 10 },
    "api/bot.js": { "memory": 256, "maxDuration": 10 }
  },
  "routes": [
    { "src": "/api/webhook", "dest": "/api/webhook.js" },
    { "src": "/api/bot", "dest": "/api/bot.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
