{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/send", "dest": "/api/send.js" },
    { "src": "/api/user", "dest": "/api/user.js" },
    { "src": "/api/caption", "dest": "/api/caption.js" },
    { "src": "/api/broadcast", "dest": "/api/broadcast.js" },
    { "src": "/api/botwebhook", "dest": "/api/botwebhook.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
